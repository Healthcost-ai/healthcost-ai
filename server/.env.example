NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/healthcost-ai
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-at-least-32-characters
CSRF_HMAC_SECRET=replace-this-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_DAYS=14
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=HealthCost AI <no-reply@example.com>
TRUST_PROXY=0
